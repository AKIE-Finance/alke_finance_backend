# --- Environment ------------------------------------------------------------
# local | staging | pilot | production  (validated at boot: src/config/env.validation.ts)
APP_ENV=local
PORT=3000
# Comma-separated allow-list; required outside local. Local with no value = any origin.
CORS_ORIGINS=http://localhost:5173

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml (host port 55432).
DATABASE_URL="postgresql://alke:alke_dev_local_only@localhost:55432/alke_finance_dev?schema=public"

# --- Redis (rate limiting, OTP counters, job locks) --------------------------
REDIS_URL="redis://localhost:55380"

# --- Authentication ----------------------------------------------------------
# >= 32 random characters outside local. Generate: openssl rand -base64 48
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="15m"

# --- Integration modes (blueprint v3.2 §4.1) ---------------------------------
# OTP demo (fixed code, returned in the API response) is refused unless APP_ENV=local.
OTP_DEMO_MODE=true
OTP_DEMO_CODE=123456
# simulated | sandbox | live   (simulated is refused on pilot/production)
PAYMENTS_MODE=simulated
# simulated | file | sftp | api
SDB_CONNECTOR=simulated
# simulated | smileid          (simulated is refused on pilot/production)
KYC_MODE=simulated

# --- Seed (prisma/seed.ts) ---------------------------------------------------
ADMIN_SEED_EMAIL=admin@alke.local
ADMIN_SEED_PASSWORD=ChangeMe!Local2026

# --- Market data --------------------------------------------------------------
FX_RATES_BASE_URL="https://open.er-api.com/v6/latest"
TWELVE_DATA_API_KEY=demo
TWELVE_DATA_BASE_URL="https://api.twelvedata.com"

# --- Identity documents storage (private bucket; location per blueprint D16) -
DOCUMENTS_BUCKET=
DOCUMENTS_ENDPOINT=
DOCUMENTS_REGION=af-south-1

# --- External providers (empty = simulated) -----------------------------------
MTN_MOMO_SUBSCRIPTION_KEY=
ORANGE_MONEY_CLIENT_ID=
CINETPAY_API_KEY=
SMILE_IDENTITY_API_KEY=
AFRICAS_TALKING_API_KEY=
SENDGRID_API_KEY=
SENTRY_DSN=
SWAGGER_ENABLED=

# --- Feature flags (comma-separated; src/common/guards/feature-flag.guard.ts) --
# EXTRAS_ENABLED : portefeuille externe, parrainage, AlKÉ Pro, NPS (hors v1.0). Vide = routes en 404.
FEATURES=
